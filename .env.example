# SubHub - example environment variables
# Local development: copy to .env.local. Docker / on-premise: copy to .env
# (read by docker-compose.yml). Deployment guide: docs/DEPLOYMENT.md

# ===========================================
# Deployment mode (server-only; validated at startup)
# ===========================================
#   single-tenant  One organisation per installation - on-premise / customer
#                  self-hosting. DEFAULT. Aliases: on-premise, self-hosted.
#   saas           Multi-tenant cloud: many organisations isolated by
#                  organizationId, managed from the super-admin console.
# Any other value stops the server with an error.
SUBHUB_DEPLOYMENT_MODE="single-tenant"

# ===========================================
# Database (PostgreSQL 15+)
# ===========================================
# Prisma connects with DIRECT_URL (see prisma/schema.prisma); keep both set.
# With docker-compose.yml both are derived from the POSTGRES_* values below.
DATABASE_URL="postgresql://subhub:change-me@localhost:5432/subhub"
DIRECT_URL="postgresql://subhub:change-me@localhost:5432/subhub"
# docker-compose.yml only (bundled Postgres container)
POSTGRES_USER="subhub"
POSTGRES_PASSWORD="change-me-to-a-long-random-password"
POSTGRES_DB="subhub"

# ===========================================
# NextAuth.js v5 configuration
# ===========================================
# Session signing secret. REQUIRED in production (the server refuses to start
# without AUTH_SECRET or NEXTAUTH_SECRET). Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_SECRET="your-secret-key-here"
# Public base URL users open (https://subhub.example.com in production)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===========================================
# Platform operator (super-admin) bootstrap - used by
#   npx tsx prisma/seeds/seed-super-admin.ts
# ===========================================
# SUPER_ADMIN_EMAIL="platform-admin@yourdomain.com"
# SUPER_ADMIN_PASSWORD=""

# ===========================================
# Google OAuth (NextAuth Provider)
# ===========================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================================
# Google Workspace Admin SDK (SSO integration)
# ===========================================
GOOGLE_ADMIN_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_ADMIN_SUBJECT="admin@yourdomain.com"

# ===========================================
# Redis (Upstash)
# ===========================================
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ===========================================
# Email (Resend)
# ===========================================
# Development only: fixed 6-digit sign-in code used instead of emailing an OTP.
# Honoured in development, or in a production build served on localhost (NEXTAUTH_URL=http://localhost:...).
# Never honoured on a deployed URL. NEVER set it on a production / customer installation.
# Without RESEND_API_KEY the code is written to the server log.
# AUTH_DEV_OTP="246810"
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="SubHub"

# ===========================================
# File Storage (Cloudflare R2)
# ===========================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="smp-files"

# ===========================================
# Cron authentication (Vercel Cron, or the docker-compose `scheduler` service)
# ===========================================
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# ===========================================
# Application settings
# ===========================================
# Local development only; the Docker image always runs with NODE_ENV=production.
NODE_ENV="development"
# Refine gradual enable feature flag
ENABLE_REFINE="false"

# ===========================================
# OpenAI API (LLM for SaaS classification)
# ===========================================
OPENAI_API_KEY="your-openai-api-key-here"
# Optional: defaults to gpt-4o-mini
OPENAI_FAST_MODEL="gpt-4o-mini"

# ===========================================
# V2 feature toggle
# ===========================================
# Whether V2 features are enabled (Tasks/Kanban, etc.)
# When set to true, V2 features become accessible
ENABLE_V2_FEATURES="false"

FLEETDM_API_URL="your-fleetdm-api-url"
FLEETDM_API_TOKEN="your-fleetdm-api-token"
# ===========================================
# Notifications — push delivery (optional)
# ===========================================
# Firebase Cloud Messaging server key. When set, push notifications are sent
# through FCM (legacy HTTP API); when empty the log-only provider is used.
FCM_SERVER_KEY=""

# ===========================================
# Apple Sign in (NextAuth Provider) — optional, enabled when both are set
# ===========================================
APPLE_CLIENT_ID="com.yourcompany.subhub.web"
APPLE_CLIENT_SECRET="generated-apple-client-secret-jwt"

# ===========================================
# Exchange rates (optional; only for finance.fxProvider = exchangerate_host)
# ===========================================
FX_API_KEY=""

# ===========================================
# Object storage (data exports, attachments)
# Overrides the system setting documents.storageProvider: local | r2 | s3
# ===========================================
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT=".data/storage"
# HMAC secret for signed local download links (falls back to AUTH_SECRET / NEXTAUTH_SECRET)
STORAGE_SIGNING_SECRET=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ===========================================
# Mailbox receipt detection (read-only OAuth)
# ===========================================
# Gmail: falls back to GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET when unset.
# Redirect URI: {NEXTAUTH_URL}/api/integrations/mailbox/gmail/callback
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
# Microsoft Entra app (tenant: common). Redirect URI: {NEXTAUTH_URL}/api/integrations/mailbox/outlook/callback
MS_GRAPH_CLIENT_ID=""
MS_GRAPH_CLIENT_SECRET=""
# 32-character key used to encrypt mailbox OAuth tokens at rest (also used by card credentials)
ENCRYPTION_KEY="change-me-to-32-characters-long!"
