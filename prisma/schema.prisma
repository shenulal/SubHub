// ─── Approvals ────────────────────────────────────────────────────

enum ApprovalRequestStatus {
  PENDING
  INFO_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  INFO_REQUESTED
  SKIPPED
}

enum ApprovalApproverType {
  USER
  MANAGER
  TEAM_APPROVER
  ROLE
}

enum ApprovalEventType {
  SUBMITTED
  APPROVED
  REJECTED
  INFO_REQUESTED
  INFO_PROVIDED
  COMMENTED
  REMINDED
  ESCALATED
  CANCELLED
  SUBSCRIPTION_CREATED
}

model ApprovalPolicy {
  id                    String               @id @default(cuid())
  organizationId        String               @map("organization_id")
  name                  String
  description           String?
  isActive              Boolean              @default(true) @map("is_active")
  priority              Int                  @default(0)
  appliesToAll          Boolean              @default(false) @map("applies_to_all")
  costThreshold         Decimal?             @map("cost_threshold") @db.Decimal(12, 2)
  costThresholdCurrency String               @default("USD") @map("cost_threshold_currency")
  categoryIds           String[]             @default([]) @map("category_ids")
  reminderAfterDays     Int?                 @map("reminder_after_days")
  escalationAfterDays   Int?                 @map("escalation_after_days")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps                 ApprovalPolicyStep[]
  requests              ApprovalRequest[]

  @@index([organizationId, isActive, priority])
  @@map("approval_policies")
}

model ApprovalPolicyStep {
  id             String               @id @default(cuid())
  policyId       String               @map("policy_id")
  stepOrder      Int                  @map("step_order")
  label          String
  approverType   ApprovalApproverType @map("approver_type")
  approverUserId String?              @map("approver_user_id")
  approverRole   UserRole?            @map("approver_role")
  policy         ApprovalPolicy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  approverUser   User?                @relation("PolicyStepApprover", fields: [approverUserId], references: [id])

  @@unique([policyId, stepOrder])
  @@map("approval_policy_steps")
}

model ApprovalRequest {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  requesterId    String                @map("requester_id")
  policyId       String?               @map("policy_id")
  catalogId      String?               @map("catalog_id")
  categoryId     String?               @map("category_id")
  subscriptionId String?               @unique @map("subscription_id")
  costCenterId   String?               @map("cost_center_id")
  serviceName    String                @map("service_name")
  vendorWebsite  String?               @map("vendor_website")
  amount         Decimal               @db.Decimal(12, 2)
  currency       String                @default("USD")
  billingCycle   BillingCycle          @default(MONTHLY) @map("billing_cycle")
  monthlyAmount  Decimal               @map("monthly_amount") @db.Decimal(12, 2)
  seats          Int?
  justification  String
  status         ApprovalRequestStatus @default(PENDING)
  currentStep    Int                   @default(1) @map("current_step")
  submittedAt    DateTime              @default(now()) @map("submitted_at")
  decidedAt      DateTime?             @map("decided_at")
  lastReminderAt DateTime?             @map("last_reminder_at")
  escalatedAt    DateTime?             @map("escalated_at")
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester      User                  @relation("ApprovalRequester", fields: [requesterId], references: [id])
  policy         ApprovalPolicy?       @relation(fields: [policyId], references: [id])
  catalog        SaaSCatalog?          @relation(fields: [catalogId], references: [id])
  category       Category?             @relation(fields: [categoryId], references: [id])
  costCenter     CostCenter?           @relation(fields: [costCenterId], references: [id])
  subscription   Subscription?         @relation(fields: [subscriptionId], references: [id])
  steps          ApprovalStep[]
  events         ApprovalEvent[]

  @@index([organizationId, status])
  @@index([requesterId])
  @@index([submittedAt])
  @@map("approval_requests")
}

model ApprovalStep {
  id         String             @id @default(cuid())
  requestId  String             @map("request_id")
  stepOrder  Int                @map("step_order")
  label      String
  approverId String             @map("approver_id")
  status     ApprovalStepStatus @default(WAITING)
  comment    String?
  dueAt      DateTime?          @map("due_at")
  decidedAt  DateTime?          @map("decided_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver   User               @relation("ApprovalStepApprover", fields: [approverId], references: [id])

  @@unique([requestId, stepOrder])
  @@index([approverId, status])
  @@map("approval_steps")
}

model ApprovalEvent {
  id        String            @id @default(cuid())
  requestId String            @map("request_id")
  actorId   String?           @map("actor_id")
  type      ApprovalEventType
  comment   String?
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")
  request   ApprovalRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User?             @relation("ApprovalEventActor", fields: [actorId], references: [id])

  @@index([requestId, createdAt])
  @@map("approval_events")
}

// ─── Notifications ────────────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationEventType {
  RENEWAL_REMINDER
  TRIAL_ENDING
  PRICE_CHANGE
  NOTICE_PERIOD
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  APPROVAL_INFO_REQUESTED
  APPROVAL_ESCALATED
  APPROVER_RENEWAL
  OFFBOARDING
  SHADOW_IT
  COST_ANOMALY
  PENDING_REVIEW
  RECEIPT_SUGGESTION
  DIGEST
  SYSTEM
}

/// Persistent per-user in-app notification (the unified notification centre).
model Notification {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  userId         String                @map("user_id")
  type           NotificationEventType
  title          String
  body           String?
  link           String?
  dedupeKey      String?               @map("dedupe_key")
  metadata       Json?
  readAt         DateTime?             @map("read_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([organizationId])
  @@map("notifications")
}

model NotificationPreference {
  id        String                @id @default(cuid())
  userId    String                @map("user_id")
  eventType NotificationEventType @map("event_type")
  channel   NotificationChannel
  enabled   Boolean               @default(true)
  updatedAt DateTime              @updatedAt @map("updated_at")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

enum DevicePlatformType {
  IOS
  ANDROID
  WEB
}

/// Push tokens registered by mobile/web clients (push delivery readiness).
model DeviceToken {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  platform   DevicePlatformType
  token      String             @unique
  deviceName String?            @map("device_name")
  lastSeenAt DateTime           @default(now()) @map("last_seen_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─── Discovery ────────────────────────────────────────────────────

model SavedView {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  entity         String       @default("subscriptions")
  name           String
  filters        Json
  sort           Json?
  isShared       Boolean      @default(false) @map("is_shared")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity, name])
  @@index([organizationId, entity])
  @@map("saved_views")
}

// ─── Email receipt detection ──────────────────────────────────────

enum MailboxProvider {
  GMAIL
  OUTLOOK
}

enum MailboxStatus {
  ACTIVE
  ERROR
  REVOKED
}

model MailboxConnection {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  userId         String              @map("user_id")
  provider       MailboxProvider
  email          String
  accessToken    String              @map("access_token")
  refreshToken   String?             @map("refresh_token")
  expiresAt      DateTime?           @map("expires_at")
  status         MailboxStatus       @default(ACTIVE)
  lastScannedAt  DateTime?           @map("last_scanned_at")
  cursor         String?
  errorMessage   String?             @map("error_message")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions    ReceiptSuggestion[]

  @@unique([userId, provider, email])
  @@index([organizationId])
  @@map("mailbox_connections")
}

enum ReceiptSuggestionStatus {
  NEW
  ACCEPTED
  DISMISSED
  DUPLICATE
}

model ReceiptSuggestion {
  id                    String                  @id @default(cuid())
  organizationId        String                  @map("organization_id")
  userId                String                  @map("user_id")
  mailboxId             String                  @map("mailbox_id")
  messageId             String                  @map("message_id")
  vendorName            String                  @map("vendor_name")
  senderEmail           String?                 @map("sender_email")
  subject               String?
  amount                Decimal?                @db.Decimal(12, 2)
  currency              String?
  billingCycle          BillingCycle?           @map("billing_cycle")
  chargedAt             DateTime?               @map("charged_at")
  nextRenewalAt         DateTime?               @map("next_renewal_at")
  confidence            Float                   @default(0.5)
  snippet               String?
  matchedCatalogId      String?                 @map("matched_catalog_id")
  matchedSubscriptionId String?                 @map("matched_subscription_id")
  status                ReceiptSuggestionStatus @default(NEW)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailbox               MailboxConnection       @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  matchedCatalog        SaaSCatalog?            @relation(fields: [matchedCatalogId], references: [id])

  @@unique([mailboxId, messageId])
  @@index([organizationId, status])
  @@map("receipt_suggestions")
}

// ─── Multi-currency ───────────────────────────────────────────────

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String   @map("base_currency")
  quoteCurrency String   @map("quote_currency")
  rate          Decimal  @db.Decimal(18, 8)
  asOf          DateTime @map("as_of")
  source        String   @default("manual")
  provider      String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([baseCurrency, quoteCurrency, asOf])
  @@index([baseCurrency, quoteCurrency])
  @@map("exchange_rates")
}

// ─── Onboarding & privacy ─────────────────────────────────────────

model OnboardingProgress {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  steps          Json         @default("{}")
  dismissedAt    DateTime?    @map("dismissed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("onboarding_progress")
}

enum DataExportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

model DataExportRequest {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  status         DataExportStatus @default(PENDING)
  format         String           @default("JSON")
  storageKey     String?          @map("storage_key")
  fileUrl        String?          @map("file_url")
  sizeBytes      Int?             @map("size_bytes")
  requestedAt    DateTime         @default(now()) @map("requested_at")
  completedAt    DateTime?        @map("completed_at")
  expiresAt      DateTime?        @map("expires_at")
  errorMessage   String?          @map("error_message")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("data_export_requests")
}

// ═══════════════════════════════════════════════════════════════════
// SubHub platform layer — RBAC, configurable settings, master data
// ═══════════════════════════════════════════════════════════════════

// ─── RBAC ─────────────────────────────────────────────────────────

/// Organisation role. System roles (ADMIN/APPROVER/MEMBER/VIEWER) are seeded per
/// organisation and mirror the legacy UserRole enum; custom roles are admin-defined.
model Role {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  key            String
  name           String
  description    String?
  isSystem       Boolean          @default(false) @map("is_system")
  isDefault      Boolean          @default(false) @map("is_default")
  legacyRole     UserRole?        @map("legacy_role")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  users          User[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

/// Global permission catalogue (resource:action), seeded from src/lib/rbac/permissions.ts
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  resource    String
  action      String
  group       String
  description String?
  roles       RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─── Configurable settings ────────────────────────────────────────

/// Typed key/value settings per organisation. Keys, defaults and validation live in
/// src/lib/settings/registry.ts; this table only stores overrides.
model OrganizationSetting {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  key            String
  value          Json
  updatedById    String?      @map("updated_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy      User?        @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_settings")
}

/// Platform-wide settings managed by SUPER_ADMIN (fallbacks for organisation settings).
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_settings")
}

/// Per-organisation override of notification copy (subject/body templates with {{placeholders}}).
model NotificationTemplate {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  eventType      NotificationEventType @map("event_type")
  channel        NotificationChannel
  locale         String                @default("en")
  subject        String?
  body           String
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, eventType, channel, locale])
  @@map("notification_templates")
}

// ─── Master data (global) ─────────────────────────────────────────

/// ISO 4217 currency master (global, seeded).
model Currency {
  code          String    @id
  name          String
  symbol        String
  decimalDigits Int       @default(2) @map("decimal_digits")
  numericCode   String?   @map("numeric_code")
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(100) @map("sort_order")
  countries     Country[]

  @@map("currencies")
}

/// ISO 3166 country master (global, seeded) with default currency and VAT.
model Country {
  code                  String    @id
  name                  String
  region                String?
  currencyCode          String?   @map("currency_code")
  defaultTaxRatePercent Decimal?  @map("default_tax_rate_percent") @db.Decimal(5, 2)
  phonePrefix           String?   @map("phone_prefix")
  isActive              Boolean   @default(true) @map("is_active")
  currency              Currency? @relation(fields: [currencyCode], references: [code])

  @@map("countries")
}

// ─── Master data (per organisation) ───────────────────────────────

model TaxRate {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  countryCode    String?        @map("country_code")
  ratePercent    Decimal        @map("rate_percent") @db.Decimal(5, 2)
  isDefault      Boolean        @default(false) @map("is_default")
  isActive       Boolean        @default(true) @map("is_active")
  validFrom      DateTime?      @map("valid_from")
  validTo        DateTime?      @map("valid_to")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]

  @@unique([organizationId, name])
  @@map("tax_rates")
}

/// Cost centre / budget owner dimension for analytics (distinct from Team hierarchy).
model CostCenter {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  code             String
  name             String
  description      String?
  ownerId          String?           @map("owner_id")
  teamId           String?           @map("team_id")
  budgetMonthly    Decimal?          @map("budget_monthly") @db.Decimal(12, 2)
  budgetCurrency   String?           @map("budget_currency")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?             @relation("CostCenterOwner", fields: [ownerId], references: [id])
  subscriptions    Subscription[]
  approvalRequests ApprovalRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("cost_centers")
}

enum PaymentMethodKind {
  CARD
  BANK
  INVOICE
  WALLET
  OTHER
}

/// Configurable payment methods (seeded defaults, admin-editable, optionally linked to a corporate card).
model PaymentMethodOption {
  id              String            @id @default(cuid())
  organizationId  String            @map("organization_id")
  code            String
  name            String
  kind            PaymentMethodKind @default(OTHER)
  corporateCardId String?           @map("corporate_card_id")
  isActive        Boolean           @default(true) @map("is_active")
  isDefault       Boolean           @default(false) @map("is_default")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]

  @@unique([organizationId, code])
  @@map("payment_method_options")
}

/// Per-organisation configuration of billing cycles: label, months per cycle (for
/// monthly/annual normalisation) and whether the cycle is offered in forms.
model BillingCycleConfig {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  cycle          BillingCycle
  label          String
  months         Int
  isEnabled      Boolean      @default(true) @map("is_enabled")
  sortOrder      Int          @default(0) @map("sort_order")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, cycle])
  @@map("billing_cycle_configs")
}
